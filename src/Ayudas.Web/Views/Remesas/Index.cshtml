@model RemesasIndexViewModel
@{
    ViewBag.Title = "Remesas";
    var resultado = Model.Resultado;
}

<h1>Remesas recibidas</h1>

<form method="get" class="filtro">
    <label for="entidadId">Entidad</label>
    <select name="entidadId" id="entidadId">
        <option value="">Todas</option>
        @foreach (var e in Model.Entidades)
        {
            <option value="@e.Id" selected="@(e.Id == Model.EntidadId)">@e.Nombre</option>
        }
    </select>
    <button type="submit">Filtrar</button>
</form>

<table class="tabla">
    <thead>
        <tr>
            <th>Referencia</th>
            <th>Entidad</th>
            <th>Convocatoria</th>
            <th>Enviada</th>
            <th>Estado</th>
            <th class="num">Ayudas</th>
            <th class="num">Importe concedido</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in resultado.Elementos)
        {
            <tr>
                <td>@r.Referencia</td>
                <td>@r.EntidadNombre</td>
                <td>@r.ConvocatoriaCodigo</td>
                <td>@r.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@r.Estado</td>
                <td class="num">@r.NumeroAyudas</td>
                <td class="num">@r.ImporteConcedido.ToString("N2")</td>
                <td><a asp-action="Detalle" asp-route-id="@r.Id">Ver</a></td>
            </tr>
        }
    </tbody>
</table>

<nav class="paginacion">
    @for (var i = 1; i <= resultado.TotalPaginas; i++)
    {
        if (i == resultado.Pagina)
        {
            <strong>@i</strong>
        }
        else
        {
            <a asp-action="Index" asp-route-pagina="@i" asp-route-entidadId="@Model.EntidadId">@i</a>
        }
    }
</nav>
