{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Read(./**/appsettings.Production.json)",
      "Edit(./**/appsettings.Production.json)"
    ]
  }
}
